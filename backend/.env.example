# Port the Express server listens on
PORT=5000

# MongoDB connection string
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/sentiqai
# Or MongoDB Atlas (replace with your own credentials/cluster):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/sentiqai?retryWrites=true&w=majority

# Secret used to sign JSON Web Tokens — use a long, random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Environment: development | production
NODE_ENV=development

# URL of the frontend, used to configure CORS
CLIENT_URL=http://localhost:3000
